rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function owns(resourceData) {
      return signedIn() && resourceData.data.userId == request.auth.uid;
    }

    function keepsOwnership() {
      return request.resource.data.userId == resource.data.userId;
    }

    // Public directory data is readable, but only its owner or an admin can mutate it.
    match /models/{modelId} {
      allow read: if true;
      allow create: if isAdmin() || (signedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (owns(resource) && keepsOwnership());
      allow delete: if isAdmin() || owns(resource);
    }

    match /agencies/{agencyId} {
      allow read: if true;
      allow create: if isAdmin() || (signedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (owns(resource) && keepsOwnership());
      allow delete: if isAdmin() || owns(resource);
    }

    match /subscribers/{subscriberId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly([
        'id', 'email', 'subscribedAt', 'frequency', 'topics', 'status', 'welcomeEmailSent'
      ])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 254;
      allow update, delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Deny every collection that is not explicitly covered above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
